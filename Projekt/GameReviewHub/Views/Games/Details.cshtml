@model GameReviewHub.Models.Game

@{
    ViewData["Title"] = "Game Details";
}

<div class="card bg-dark text-light shadow mb-4">
    <div class="card-body">
        <h1 class="card-title mb-3">🎮 @Model.Title</h1>

        <p class="mb-2">
            <strong>Studio:</strong> @Model.Studio
        </p>

        <p class="mb-2">
            <strong>Release year:</strong> @Model.ReleaseYear
        </p>

        <p class="mb-2">
            <strong>Genre:</strong> @Model.Genre?.Name
        </p>

        <p class="mb-2">
            <strong>Rating:</strong>
            <span class="badge bg-warning text-dark">⭐ @Model.Rating / 10</span>
        </p>

        <p class="mt-3">
            <strong>Description:</strong><br />
            @Model.Description
        </p>
    </div>
</div>

<h3 class="mb-3">📝 Reviews</h3>

@if (Model.Reviews != null && Model.Reviews.Any())
{
    <div class="row">
        @foreach (var review in Model.Reviews)
        {
            <div class="col-md-6 mb-3">
                <div class="card border-dark shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@review.Author</h5>
                        <span class="badge bg-warning text-dark mb-2">⭐ @review.Score / 10</span>
                        <p class="card-text">@review.Comment</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No reviews added for this game yet.</p>
}

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    <a asp-controller="Reviews" asp-action="Create" class="btn btn-success">Add Review</a>
</div>
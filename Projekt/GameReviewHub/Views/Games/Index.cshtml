@model IEnumerable<GameReviewHub.Models.Game>

@{
    ViewData["Title"] = "Games";
}

<h1 class="mb-4">🎮 Game Library</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search by title or studio..." />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-dark">
                Search
            </button>
        </div>

        <div class="col-md-2">
            <a asp-action="Create" class="btn btn-success">
                + Add Game
            </a>
        </div>
    </div>
</form>

<table class="table table-dark table-hover align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th>Studio</th>
            <th>Year</th>
            <th>Rating</th>
            <th>Description</th>
            <th>Genre</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>
                <strong>@item.Title</strong>
            </td>

            <td>
                @item.Studio
            </td>

            <td>
                @item.ReleaseYear
            </td>

            <td>
                <span class="badge bg-warning text-dark">
                    ⭐ @item.Rating
                </span>
            </td>

            <td>
                @item.Description
            </td>

            <td>
                @item.Genre?.Name
            </td>

            <td>
                <a asp-action="Edit"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-primary">
                    Edit
                </a>

                <a asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-info">
                    Details
                </a>

                <a asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-danger">
                    Delete
                </a>
            </td>
        </tr>
}
    </tbody>
</table>